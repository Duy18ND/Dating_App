# Sao chép thành .env.local rồi điền giá trị. Không commit .env.local.

# Supabase (chạy supabase/migrations/0001_init.sql trước)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2. Bật CORS cho phép GET từ domain của app, nếu không sẽ không xuất được PDF.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare Turnstile. Máy dev để trống được; production bắt buộc có.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chuỗi ngẫu nhiên dài, dùng để hash IP và bảo vệ cron
IP_HASH_SALT=
CRON_SECRET=

# Domain chính thức (dùng cho thẻ OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Thông tin donate hiển thị cạnh ảnh QR (để trống thì ẩn)
NEXT_PUBLIC_DONATE_BANK_NAME=
NEXT_PUBLIC_DONATE_ACCOUNT_NUMBER=
NEXT_PUBLIC_DONATE_ACCOUNT_NAME=
